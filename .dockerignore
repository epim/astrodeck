# Keep the build context small and the image reproducible. Anything that is
# built, cached, machine-specific or private stays out.

.git
.github
.remember
.claude
.codex

# Built and cached artefacts — the image builds its own.
ui/node_modules
ui/dist
server/.venv
server/build
server/dist
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
native/target

# Live rig state. Baking a config into an image would ship somebody's site
# coordinates and user store to whoever pulls it.
server/config
server/captures
data

# NOT excluded on purpose: packaging/native_probe.py is copied into the image and
# run against the native wheel at build time (see the Dockerfile). The wheels
# themselves arrive as the named build context `native` (--build-context), outside
# this context, so no pattern may exclude a native-wheels directory either.

# Docs, tests and scratch: not needed at runtime.
docs
relay
*.md
!README.md
capture_*.py
*.png
*.html
