[Unit]
Description=AstroDeck unprivileged WiFi setup portal
RequiresMountsFor=/data
ConditionPathIsMountPoint=/data
Requires=astrodeck-provision-broker.socket
After=astrodeck-recovery-record.service astrodeck-provision-broker.socket network.target
Wants=astrodeck-recovery-record.service

[Service]
Type=simple
User=astrodeck-setup
Group=astrodeck-setup
ExecStart=/usr/bin/python3 /usr/local/lib/astrodeck/astrodeck-provision.py run
Restart=no
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
# One rule per assignment: systemd rejects a space-separated list here and, with SocketBindDeny=any in force, the portal could then bind nothing.
SocketBindAllow=ipv4:tcp:80
SocketBindAllow=ipv4:udp:53
IPAddressDeny=any
IPAddressAllow=10.42.0.0/24
InaccessiblePaths=-/run/systemd/private -/run/dbus/system_bus_socket -/run/systemd/system -/etc/systemd/system
LimitCORE=0
TasksMax=64
LimitNOFILE=128

[Install]
WantedBy=multi-user.target
