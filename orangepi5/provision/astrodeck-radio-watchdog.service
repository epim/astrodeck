[Unit]
Description=AstroDeck WiFi radio watchdog (heal a crashed radio)
# Fires from astrodeck-radio-watchdog.timer. If the wlan0 device node has
# vanished (the brcmfmac firmware-crash signature, distinct from an ordinary
# disconnect where the node remains) it asks astrodeck-radio-reset.service to
# reload the driver, so an appliance recovers on its own instead of needing a
# customer to unplug it.

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/lib/astrodeck/astrodeck-provision-broker.py radio-watchdog
# No capabilities of its own: it only reads /sys and asks systemd to start the
# reset unit, which is where the privilege lives.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LimitCORE=0
TasksMax=8
LimitNOFILE=32
