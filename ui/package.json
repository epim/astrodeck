{
  "name": "astrodeck-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --import tsx run-tests.mjs",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "module": "./dist-lib/index.es.js",
  "types": "./dist-lib/types/design-system.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/design-system.d.ts",
      "import": "./dist-lib/index.es.js"
    },
    "./style.css": "./dist-lib/style.css"
  }
