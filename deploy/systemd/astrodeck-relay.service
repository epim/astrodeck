[Unit]
Description=AstroDeck relay (unprivileged, loopback only)
Documentation=https://github.com/epim/astrodeck
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=astrodeck-relay
Group=astrodeck-relay
UMask=0077
WorkingDirectory=/var/lib/astrodeck-relay
StateDirectory=astrodeck-relay
StateDirectoryMode=0700
RuntimeDirectory=astrodeck-relay
RuntimeDirectoryMode=0700
Environment=RELAY_BIND_HOST=127.0.0.1
Environment=RELAY_BIND_PORT=8080
Environment=RELAY_DEVICE_TOKENS_FILE=/etc/astrodeck-relay/device_tokens.json
Environment=RELAY_FORWARDED_ALLOW_IPS=127.0.0.1
Environment=RELAY_UVICORN_ACCESS_LOG=false
ExecStart=/opt/astrodeck-relay/venv/bin/python -m relay
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=30s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/astrodeck-relay
LimitCORE=0
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
